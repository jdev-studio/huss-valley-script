local function movementDirection(humanoid)
    local forward = (key(0x57) and 1 or 0) - (key(0x53) and 1 or 0)
    local side = (key(0x44) and 1 or 0) - (key(0x41) and 1 or 0)
    local anyKeys = key(0x57) or key(0x53) or key(0x44) or key(0x41)
    if anyKeys and forward == 0 and side == 0 then return nil end
    local direction = read(humanoid, "MoveDirection")
    if vector(direction) and horizontal(direction) > .01 then return direction end
    if not anyKeys then return nil end
    local cf = read(read(world, "CurrentCamera"), "CFrame")
    local look, right = read(cf, "LookVector"), read(cf, "RightVector")
    if not vector(look) or not vector(right) then
        local success, components = pcall(function() return { cf:GetComponents() } end)
        if not success or #components < 12 then return nil end
        look = Vector3.new(-components[6], -components[9], -components[12])
        right = Vector3.new(components[4], components[7], components[10])
    end
    -- Normalize each planar camera axis before combining diagonal input.
    local lookLength, rightLength = horizontal(look), horizontal(right)
    if lookLength < .001 or rightLength < .001 then return nil end
    return Vector3.new(look.X / lookLength * forward + right.X / rightLength * side, 0,
        look.Z / lookLength * forward + right.Z / rightLength * side)
end
local function movementStep(c, root, now)
