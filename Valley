local function serverTime()
    local success, now = pcall(function() return world:GetServerTimeNow() end)
    return success and finite(now) and now or os.time()
end
local function cooldownWrite(tuner, key, value)
    local current = attr(tuner.object, key)
    if type(current) ~= type(value) then error(key .. " unavailable or wrong type") end
    local saved = tuner.saved[key]
    if current == value then return true end
    if not saved then saved = { natural = current }; tuner.saved[key] = saved
    elseif current ~= saved.applied then saved.natural = current end
    tuner.object:SetAttribute(key, value)
    saved.applied = value
    local after = attr(tuner.object, key)
    return after == value or (finite(after) and finite(value) and math.abs(after - value) < .001)
end
-- CharacterMovementClient publishes attributes from MovementModel's private
-- timer. Writing those attributes cannot change canBoost(). Locate only the
-- numeric 'cooldown' entry that follows this character's natural dash across
-- three different published timer values. Keep a confirmed address for later
-- dashes on this character. Never write every matching GC key.
local function timerRead(entry, limit)
    local success, value = pcall(memory_read, "double", entry.addr)
    if success and finite(value) and value >= 0 and value < (limit or 60) then return value end
end
local function timerMatches(value, published)
    -- Attributes are published every .1 s, so live memory may be slightly ahead.
    return finite(value) and value <= published + .015 and published - value <= .16
end
local dashKeys = { "cooldown", "dashCount", "dashRemaining", "recoveryRemaining" }
local function memoryValue(kind, address)
    local success, value = pcall(memory_read, kind, address)
    if success then return value end
end
local function nodeKey(address, key, reference)
    -- This node format was read directly from the live, GC-identified state.
    -- Enable the fast path only when every field's type and exact name prove it.
    local pointer = memoryValue("uintptr_t", address + 16)
    if not validAddress(pointer) or pointer < 65536 or (reference and pointer ~= reference) then return end
    local tag = memoryValue("int", address + 28)
    if memoryValue("int", address + 12) ~= 3 or not finite(tag) or tag % 16 ~= 6 then return end
    if memoryValue("int", pointer + 20) ~= #key or memoryValue("string", pointer + 24) ~= key then return end
    return pointer
end
local function learnDashNodes(tuner, group, count)
    if type(memory_write) ~= "function" then return end
    local base, layout = tonumber(group.cooldown.addr), { offsets = {}, references = {} }
    for _, name in ipairs(dashKeys) do
        local entry = group[name]
        if not entry and name == "dashCount" then
            -- Split GC ownership can hide the counter. Read nearby nodes only;
            -- require a unique exact key with this character's private count.
            for offset = -1024, 1024, 32 do
                local address = base + offset
                if nodeKey(address, name) and timerRead({ addr = address }, 1e12) == count then
                    if entry then return end
                    entry = { addr = address }
                end
            end
        end
        local address = entry and tonumber(entry.addr)
        if not validAddress(address) or math.abs(address - base) > 2048 or (address - base) % 8 ~= 0 then return end
        local pointer = nodeKey(address, name)
        if not pointer then return end
        layout.offsets[name], layout.references[name] = address - base, pointer
    end
    tuner.nodeLayouts = tuner.nodeLayouts or {}
    local signature = table.concat({ layout.offsets.dashCount, layout.offsets.dashRemaining, layout.offsets.recoveryRemaining,
        layout.references.cooldown, layout.references.dashCount, layout.references.dashRemaining, layout.references.recoveryRemaining }, ":")
    layout.signature = signature
    for i = #tuner.nodeLayouts, 1, -1 do
        if tuner.nodeLayouts[i].signature == signature then table.remove(tuner.nodeLayouts, i) end
    end
    table.insert(tuner.nodeLayouts, 1, layout)
    if #tuner.nodeLayouts > 2 then table.remove(tuner.nodeLayouts) end
    if not tuner.nodeAnchor then log("Dash bounded lookup enabled; exact numeric field names verified") end
    tuner.nodeAnchor = base
end
local function dashTimerWrite(entries, values)
    if not entries[1].localNode then return applygc(entries, values) end
    for _, entry in ipairs(entries) do
        if not nodeKey(entry.addr, entry.key, entry.keyRef) then return nil end
    end
    for _, entry in ipairs(entries) do memory_write("double", entry.addr, values[entry.key]) end
    return #entries
end
local function applyDashCap(tuner, entry, before, now)
    local remaining = math.max(0, tuner.seconds - (now - tuner.started))
    if before <= remaining then tuner.completed = true; tuner.status = "Natural timer is shorter"; return end
    local changed = dashTimerWrite({ entry }, { cooldown = remaining })
    if changed == nil and entry.localNode then tuner.status = "Dash node changed; retry next frame"; return end
    local after = timerRead(entry)
    assert(changed == 1 and finite(after) and math.abs(after - remaining) <= .03, "Internal timer write not observed")
    tuner.completed, tuner.applied, tuner.candidates = true, remaining, nil
    tuner.writtenEntry, tuner.appliedAt = entry, now
    tuner.status = "Internal timer shortened; waiting for game readiness"
    log(string.format("Dash %s timer @%s: %.3f -> %.3f; readback %.3f", tuner.dashCount, tostring(entry.addr), before, remaining, after))
end
local function dashRearmStep(tuner, object, now)
    if not tuner.rearm or tuner.seconds ~= 0 or not tuner.pinned or not tuner.applied
        or tuner.corrected or tuner.rearmedCount == tuner.dashCount then return end
    -- Matcha's observed GC descriptors include their owning table address.
    -- Require it plus the game's dash count; never guess offsets or patch all keys.
    local owner = tonumber(tuner.pinned.tbl)
    if not validAddress(owner) then tuner.status = "Re-arm unavailable: GC table owner missing"; return end
    if type(iskeypressed) ~= "function" or type(isrbxactive) ~= "function" then
        tuner.status = "Re-arm unavailable: keyboard/focus API missing"; return
    end
    local focusOK, focused = pcall(isrbxactive)
    local keyOK, held = pcall(iskeypressed, 0x20)
    if not focusOK or focused ~= true or not keyOK or type(held) ~= "boolean" then return end
    if held then tuner.status = "Timer reset; release Space to re-arm"; return end
    if attr(object, "MovementLocked") == true or attr(object, "TackleActive") == true
        or attr(object, "GearMotion") then return end
    local humanoid = child(object, "Humanoid")
    local root = child(object, "HumanoidRootPart")
    local health = read(humanoid, "Health")
    if not finite(health) or health <= 0 or read(humanoid, "Sit") == true
        or read(humanoid, "PlatformStand") == true or not root or read(root, "Anchored") == true then return end
    if not tuner.gates then tuner.status = "Re-arm: wait for a complete state scan"; return end
    local gates = tuner.gates
    if tonumber(gates.cooldown.tbl) ~= owner or tonumber(gates.cooldown.addr) ~= tonumber(tuner.pinned.addr) then
        tuner.gates = nil; return
    end
    local count = tuner.stateValidatedCount
    if gates.dashCount then count = timerRead(gates.dashCount, 1e12) end
    local motion, recovery = timerRead(gates.dashRemaining), timerRead(gates.recoveryRemaining)
    local cooldown = timerRead(gates.cooldown)
    if count ~= attr(object, "DashCount") or count ~= tuner.dashCount or not motion or not recovery
        or not cooldown or cooldown > .03 then
        tuner.status = "Re-arm state changed; retry next frame"; return
    end
    if motion == 0 and recovery == 0 then tuner.rearmedCount = count; return end
    -- A GC scan may outlast a key transition. Check fresh input and count again
    -- before cancelling motion, so an intervening press is not cut short.
    focusOK, focused = pcall(isrbxactive)
    keyOK, held = pcall(iskeypressed, 0x20)
    if not focusOK or focused ~= true or not keyOK or held ~= false
        or id(read(me, "Character")) ~= id(object) or attr(object, "MovementLocked") == true
        or (gates.dashCount and timerRead(gates.dashCount, 1e12) ~= count)
        or attr(object, "DashCount") ~= count then return end
    local changed = dashTimerWrite({ gates.cooldown, gates.dashRemaining, gates.recoveryRemaining },
        { cooldown = 0, dashRemaining = 0, recoveryRemaining = 0 })
    if changed == nil and gates.cooldown.localNode then tuner.status = "Dash node changed; retry next frame"; return end
    assert(changed == 3 and timerRead(gates.cooldown) == 0 and timerRead(gates.dashRemaining) == 0
        and timerRead(gates.recoveryRemaining) == 0, "Dash re-arm write not observed")
    tuner.rearmedCount = count
    tuner.status = "Private dash gates cleared; turn + Space for another dash"
    log(string.format("Dash %s release re-arm: motion %.3f / recovery %.3f -> 0", count, motion, recovery))
end
local function selectDashState(groups, count, published)
    local selected, matches = nil, 0
    for _, group in ipairs(groups or {}) do
        if group.dashCount and timerRead(group.dashCount, 1e12) == count and timerMatches(timerRead(group.cooldown), published)
            and timerRead(group.dashRemaining) and timerRead(group.recoveryRemaining) then
            selected, matches = group, matches + 1
        end
    end
    return matches == 1 and selected or nil, matches
end
local function nearbyDashState(tuner, count, published)
    if not tuner.nodeLayouts or not tuner.nodeAnchor or tuner.nodeAttempted then return nil, false end
    local search = tuner.nodeSearch
    if not search then
        search = { anchor = tuner.nodeAnchor, cursor = -16384, groups = {}, seen = {}, began = tick() }
        tuner.nodeSearch = search
    end
    local frameStart = tick()
    for i = 1, 256 do
        if search.cursor > 16384 or (i > 1 and tick() - frameStart >= .003) then break end
        local base = search.anchor + search.cursor
        search.cursor = search.cursor + 8
        local pointer = memoryValue("uintptr_t", base + 16)
        for _, layout in ipairs(tuner.nodeLayouts) do
            if pointer == layout.references.cooldown and not search.seen[base .. ":" .. layout.signature] then
                local group = { localNodes = true }
                for _, name in ipairs(dashKeys) do
                    local address = base + layout.offsets[name]
                    if not nodeKey(address, name, layout.references[name]) then group = nil; break end
                    -- tbl is a consistency token for these four validated nodes;
                    -- it is not presented as an actual Lua table-header address.
                    group[name] = { key = name, type = "number", vtt = 3, addr = address,
                        tbl = base, localNode = true, keyRef = layout.references[name] }
                end
                search.seen[base .. ":" .. layout.signature] = true
                if group then search.groups[#search.groups + 1] = group end
            end
        end
    end
    if search.cursor <= 16384 then tuner.status = "Checking nearby dash nodes"; return nil, true end
    local selected, matches = selectDashState(search.groups, count, published)
    search.finishedAt = search.finishedAt or tick()
    if matches == 0 and #search.groups > 0 and tick() - search.finishedAt < .12 then
        tuner.status = "Waiting for nearby dash publication"; return nil, true
    end
    tuner.nodeSearch, tuner.nodeAttempted = nil, true
    log(string.format("Dash bounded lookup: %d live matches in %.3fs", matches, tick() - search.began))
    if selected then
        table.insert(tuner.stateGroups, 1, selected)
        if #tuner.stateGroups > 32 then table.remove(tuner.stateGroups) end
    end
    return selected, false
end
local function bindDashState(tuner, group, count)
    -- A previous successful write belongs to the previous binding, even if the
    -- game keeps the dash count unchanged while rebuilding or reusing its state.
    tuner.completed, tuner.applied, tuner.corrected, tuner.writtenEntry, tuner.appliedAt = false, nil, nil, nil, nil
    tuner.rearmedCount = nil
    tuner.stateGroup, tuner.gates, tuner.pinned = group, group, group.cooldown
    tuner.stateLost, tuner.stateFaultAt, tuner.stateRefreshActive = nil, nil, nil
    tuner.stateValidatedCount = count
    tuner.nodeSearch, tuner.nodeAttempted = nil, nil
    learnDashNodes(tuner, group, count)
    log((group.localNodes and "Confirmed nearby dash nodes @" or group.correlated and "Confirmed dash timers by natural descent @" or "Confirmed complete dash state @")
        .. tostring(tuner.pinned.tbl) .. "; count " .. count)
end
local function observeSplitDashState(tuner, count, published)
    -- Live Matcha scans can assign the count and three timers different tbl IDs.
    -- Keep the timer ownership requirement, then identify one timer group by
    -- three descending game-published observations during a natural moving dash.
    local available = false
    for _, group in ipairs(tuner.stateGroups or {}) do if not group.dashCount then available = true end end
    if not available then return nil, false end
    if published <= 0 then tuner.status = "Dash once to identify the timer group"; return nil, true end
    if tuner.stateProbeCount ~= count then
        tuner.stateProbeCount, tuner.stateObserved, tuner.stateCandidates = count, published, {}
        for _, group in ipairs(tuner.stateGroups) do
            local cooldown, motion = timerRead(group.cooldown), timerRead(group.dashRemaining)
            if not group.dashCount and timerMatches(cooldown, published) and cooldown > 0
                and motion and motion > 0 and timerRead(group.recoveryRemaining) then
                tuner.stateCandidates[#tuner.stateCandidates + 1] = { group = group, last = cooldown, motion = motion, samples = 1 }
            end
        end
    elseif published ~= tuner.stateObserved then
        tuner.stateObserved = published
        local survivors = {}
        for _, candidate in ipairs(tuner.stateCandidates or {}) do
            local cooldown, motion = timerRead(candidate.group.cooldown), timerRead(candidate.group.dashRemaining)
            if timerMatches(cooldown, published) and candidate.last - cooldown > .015
                and motion and motion <= candidate.motion and timerRead(candidate.group.recoveryRemaining) then
                candidate.last, candidate.motion, candidate.samples = cooldown, motion, candidate.samples + 1
                survivors[#survivors + 1] = candidate
            end
        end
        tuner.stateCandidates = survivors
    end
    local candidates = tuner.stateCandidates or {}
    if #candidates == 1 and candidates[1].samples >= 3 then
        local group = candidates[1].group
        group.correlated = true
        return group, true
    end
    tuner.status = #candidates > 1 and "Timer groups ambiguous; no write" or "Identifying dash timer group"
    return nil, #candidates > 0
end
local function dashStateStep(tuner, object, now)
    if type(getgc) ~= "function" or type(applygc) ~= "function" or type(memory_read) ~= "function" then
        tuner.status = "Internal state APIs unavailable"; return
    end
    local count, published, ready = attr(object, "DashCount"), attr(object, "DashCooldown"), attr(object, "DashReady")
    if not finite(count) or count < 0 or count % 1 ~= 0 or not finite(published) or type(ready) ~= "boolean" then
        tuner.status = "Dash state unavailable"; return
    end
    local mode = attr(object, "MovementState")
    local idle = ready and published <= 0 and mode ~= "Boosting" and mode ~= "Dashing" and mode ~= "Recovering"
    if idle then tuner.stateReadyAt = tuner.stateReadyAt or now else tuner.stateReadyAt = nil end
    -- Try known descriptors before any expensive refresh. Published and private
    -- counts can briefly arrive in either order, even though the table is valid.
    if tuner.stateLost and tuner.stateGroups then
        local cached = selectDashState(tuner.stateGroups, count, published)
        if cached then bindDashState(tuner, cached, count) end
        if not cached and published > 0 then
            local waiting
            cached, waiting = observeSplitDashState(tuner, count, published)
            if cached then bindDashState(tuner, cached, count)
            elseif waiting and now - (tuner.stateFaultAt or now) < .7 then
                -- Calibrate known timer triples before blocking on a full heap scan.
                -- Three natural observations still establish identity; no writes yet.
                return
            end
        end
        if tuner.stateLost then
            local nearby, pending = nearbyDashState(tuner, count, published)
            if nearby then bindDashState(tuner, nearby, count)
            elseif pending then return end
        end
    end
    if not tuner.stateGroups or (tuner.stateLost and (tuner.stateRefreshActive or (idle and now - tuner.stateReadyAt >= .15))
        and now >= (tuner.nextStateScan or 0)) then
        if not idle and not tuner.stateRefreshActive then tuner.status = "Wait for a natural ready state to scan"; return end
        -- Initial scans wait for idle. Confirmed invalid addresses recover during
        -- motion too; waiting for natural readiness creates repeated normal dashes.
