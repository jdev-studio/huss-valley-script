local function timerRead(entry, limit)
    local success, value = pcall(memory_read, "double", entry.addr)
    if success and finite(value) and value >= 0 and value < (limit or 60) then return value end
end
local function scanDashGc(tuner, keys, now)
    if now < (tuner.nextGcRetry or 0) then return end
    local success, entries = pcall(getgc, keys)
    if not success or type(entries) ~= "table" then
        tuner.nextGcRetry = tick() + 1
        tuner.status = "Memory scan unavailable; retrying"
        if not tuner.gcFault then log("Dash scan waiting: " .. tostring(entries)) end
        tuner.gcFault = true
        return
    end
    if tuner.gcFault then log("Dash memory scan recovered") end
    tuner.nextGcRetry, tuner.gcFault = nil, nil
    local valid = {}
    for _, entry in ipairs(entries) do
        if type(entry) == "table" then valid[#valid + 1] = entry end
    end
    return valid
end
local function timerMatches(value, published)

    return finite(value) and value <= published + .015 and published - value <= .16
end
local dashKeys = { "cooldown", "dashCount", "dashRemaining", "recoveryRemaining" }
local function memoryValue(kind, address)
    local success, value = pcall(memory_read, kind, address)
    if success then return value end
end
local function nodeKey(address, key, reference, valueTag)

    local pointer = memoryValue("uintptr_t", address + 16)
    if not validAddress(pointer) or pointer < 65536 or (reference and pointer ~= reference) then return end
    local tag = memoryValue("int", address + 28)
    if memoryValue("int", address + 12) ~= (valueTag or 3) or not finite(tag) or tag % 16 ~= 6 then return end
    if memoryValue("int", pointer + 20) ~= #key or memoryValue("string", pointer + 24) ~= key then return end
    return pointer
end
local function learnDashNodes(tuner, group, count)
    if type(memory_write) ~= "function" then return end
    local base, layout = tonumber(group.cooldown.addr), { offsets = {}, references = {} }
    for _, name in ipairs(dashKeys) do
        local entry = group[name]
        if not entry and name == "dashCount" then

            for offset = -1024, 1024, 32 do
                local address = base + offset
                if nodeKey(address, name) and timerRead({ addr = address }, 1e12) == count then
                    if entry then return end
                    entry = { addr = address }
                end
            end
        end
        local address = entry and tonumber(entry.addr)
        if not validAddress(address) or math.abs(address - base) > 2048 or (address - base) % 8 ~= 0 then return end
        local pointer = nodeKey(address, name)
        if not pointer then return end
        layout.offsets[name], layout.references[name] = address - base, pointer
    end
    tuner.nodeLayouts = tuner.nodeLayouts or {}
    local signature = table.concat({ layout.offsets.dashCount, layout.offsets.dashRemaining, layout.offsets.recoveryRemaining,
        layout.references.cooldown, layout.references.dashCount, layout.references.dashRemaining, layout.references.recoveryRemaining }, ":")
    layout.signature = signature
    for i = #tuner.nodeLayouts, 1, -1 do
        if tuner.nodeLayouts[i].signature == signature then table.remove(tuner.nodeLayouts, i) end
    end
    table.insert(tuner.nodeLayouts, 1, layout)
    if #tuner.nodeLayouts > 2 then table.remove(tuner.nodeLayouts) end
    if not tuner.nodeAnchor then log("Dash bounded lookup enabled; exact numeric field names verified") end
    tuner.nodeAnchor = base
end
local function dashTimerWrite(entries, values)
    if not entries[1].localNode then return applygc(entries, values) end
    for _, entry in ipairs(entries) do
        if not nodeKey(entry.addr, entry.key, entry.keyRef) then return nil end
    end
    for _, entry in ipairs(entries) do
        if entry.tableAddress and memoryValue("uintptr_t", entry.tableAddress + entry.nodeOffset) ~= entry.nodeBase then return nil end
        memory_write("double", entry.addr, values[entry.key])
    end
    return #entries
end
local function applyDashCap(tuner, entry, before, now)
    local remaining = math.max(0, tuner.seconds - (now - tuner.started))
    if before <= remaining then tuner.completed = true; tuner.status = "Natural timer is shorter"; return end
    local changed = dashTimerWrite({ entry }, { cooldown = remaining })
    if changed == nil and entry.localNode then tuner.status = "Dash node changed; retry next frame"; return end
    local after = timerRead(entry)
    assert(changed == 1 and finite(after) and math.abs(after - remaining) <= .03, "Internal timer write not observed")
    tuner.completed, tuner.applied, tuner.candidates = true, remaining, nil
    tuner.writtenEntry, tuner.appliedAt = entry, now
    tuner.status = "Internal timer shortened; waiting for game readiness"
    log(string.format("Dash %s timer @%s: %.3f -> %.3f; readback %.3f", tuner.dashCount, tostring(entry.addr), before, remaining, after))
end
local function dashRearmStep(tuner, object, now)
    if not tuner.rearm or tuner.seconds ~= 0 or not tuner.pinned or not tuner.applied
        or tuner.corrected or tuner.rearmedCount == tuner.dashCount then return end

    local owner = tonumber(tuner.pinned.tbl)
    if not validAddress(owner) then tuner.status = "Re-arm unavailable: GC table owner missing"; return end
    if type(iskeypressed) ~= "function" or type(isrbxactive) ~= "function" then
        tuner.status = "Re-arm unavailable: keyboard/focus API missing"; return
    end
    local focusOK, focused = pcall(isrbxactive)
    local keyOK, held = pcall(iskeypressed, 0x20)
    if not focusOK or focused ~= true or not keyOK or type(held) ~= "boolean" then return end
    if held then tuner.status = "Timer reset; release Space to re-arm"; return end
    if attr(object, "MovementLocked") == true or attr(object, "TackleActive") == true
        or attr(object, "GearMotion") then return end
    local humanoid = child(object, "Humanoid")
    local root = child(object, "HumanoidRootPart")
    local health = read(humanoid, "Health")
    if not finite(health) or health <= 0 or read(humanoid, "Sit") == true
        or read(humanoid, "PlatformStand") == true or not root or read(root, "Anchored") == true then return end
    if not tuner.gates then tuner.status = "Re-arm: wait for a complete state scan"; return end
    local gates = tuner.gates
    if tonumber(gates.cooldown.tbl) ~= owner or tonumber(gates.cooldown.addr) ~= tonumber(tuner.pinned.addr) then
        tuner.gates = nil; return
    end
    local count = tuner.stateValidatedCount
    if gates.dashCount then count = timerRead(gates.dashCount, 1e12) end
    local motion, recovery = timerRead(gates.dashRemaining), timerRead(gates.recoveryRemaining)
    local cooldown = timerRead(gates.cooldown)
    if count ~= attr(object, "DashCount") or count ~= tuner.dashCount or not motion or not recovery
        or not cooldown or cooldown > .03 then
        tuner.status = "Re-arm state changed; retry next frame"; return
    end
    if motion == 0 and recovery == 0 then tuner.rearmedCount = count; return end

    focusOK, focused = pcall(isrbxactive)
    keyOK, held = pcall(iskeypressed, 0x20)
    if not focusOK or focused ~= true or not keyOK or held ~= false
        or id(read(me, "Character")) ~= id(object) or attr(object, "MovementLocked") == true
        or (gates.dashCount and timerRead(gates.dashCount, 1e12) ~= count)
        or attr(object, "DashCount") ~= count then return end
    local changed = dashTimerWrite({ gates.cooldown, gates.dashRemaining, gates.recoveryRemaining },
        { cooldown = 0, dashRemaining = 0, recoveryRemaining = 0 })
    if changed == nil and gates.cooldown.localNode then tuner.status = "Dash node changed; retry next frame"; return end
    assert(changed == 3 and timerRead(gates.cooldown) == 0 and timerRead(gates.dashRemaining) == 0
        and timerRead(gates.recoveryRemaining) == 0, "Dash re-arm write not observed")
    tuner.rearmedCount = count
    tuner.status = "Private dash gates cleared; turn + Space for another dash"
    log(string.format("Dash %s release re-arm: motion %.3f / recovery %.3f -> 0", count, motion, recovery))
end
local function selectDashState(groups, count, published)
    local selected, matches = nil, 0
    for _, group in ipairs(groups or {}) do
        if group.dashCount and timerRead(group.dashCount, 1e12) == count and timerMatches(timerRead(group.cooldown), published)
            and timerRead(group.dashRemaining) and timerRead(group.recoveryRemaining) then
            selected, matches = group, matches + 1
        end
    end
    return matches == 1 and selected or nil, matches
end
local function hashDashField(base, size, reference, name, valueTag)
    local hash = memoryValue("int", reference + 16)
    if not finite(hash) or hash % 1 ~= 0 then return end
    local index, visited = hash % size, {}
    for _ = 1, 8 do
        if index < 0 or index >= size or visited[index] then return end
        visited[index] = true
        local address = base + index * 32
        local pointer = memoryValue("uintptr_t", address + 16)
        local tag = memoryValue("int", address + 28)
        if not finite(tag) or tag % 1 ~= 0 or tag % 16 == 0 then return end
        if pointer == reference then
            if nodeKey(address, name, reference, valueTag) then return address end
            return
        end
        local nextIndex = math.floor(tag / 16)
        if nextIndex == 0 then return end
        index = index + nextIndex
    end
end
local function preparePortableDash(tuner, entries)
    if type(memory_write) ~= "function" then
        tuner.portableStatus = "GC grouping unavailable; enable memory writes in Matcha"; return
    end
    local references, seeds, seen = {}, {}, {}
    local keys = { cooldown = true, dashCount = true, dashRemaining = true, recoveryRemaining = true }
    for _, entry in ipairs(entries) do
        local address = tonumber(entry.addr)
        if keys[entry.key] and entry.type == "number" and validAddress(address) then
            local reference = nodeKey(address, entry.key)
            if reference then
                if references[entry.key] and references[entry.key] ~= reference then
                    tuner.portableStatus = "Multiple Lua key namespaces; no unverified write"; return
                end
                references[entry.key] = reference
                if entry.key == "cooldown" and not seen[address] then
                    seeds[#seeds + 1] = address; seen[address] = true
                end
            end
        end
    end
    for _, name in ipairs(dashKeys) do
        if not references[name] then
            tuner.portableStatus = "Cannot verify " .. name .. " nodes; check Matcha memory access/version"; return
        end
    end
    tuner.portableStatus = nil
    tuner.portableScan = { references = references, seeds = seeds, seed = 1, power = 5, index = 0,
        groups = {}, seen = {}, began = tick() }
end
local function portableDashState(tuner, count, published)
    local scan = tuner.portableScan
    if not scan then return nil, false end
    local began = tick()
    for attempt = 1, 128 do
        if scan.seed > #scan.seeds or (attempt > 1 and tick() - began >= .003) then break end
        local size = 2 ^ scan.power
        local seed = scan.seeds[scan.seed]
        local base = seed - scan.index * 32
        scan.index = scan.index + 1
        if scan.index >= size then
            scan.index = 0; scan.power = scan.power + 1
            if scan.power > 7 then scan.power = 5; scan.seed = scan.seed + 1 end
        end
        if hashDashField(base, size, scan.references.cooldown, "cooldown") == seed then
            local group, addresses = { localNodes = true, portable = true }, {}
            for _, name in ipairs(dashKeys) do
                local address = hashDashField(base, size, scan.references[name], name)
                if not address then group = nil; break end
                group[name] = { key = name, type = "number", vtt = 3, addr = address,
                    tbl = base, localNode = true, keyRef = scan.references[name] }
                addresses[#addresses + 1] = tostring(address)
            end
            if group then
                local signature = table.concat(addresses, ":")
                if not scan.seen[signature] then
                    scan.seen[signature] = true; scan.groups[#scan.groups + 1] = group
                end
            end
        end
    end
    if scan.seed <= #scan.seeds then tuner.status = "Identifying dash tables without GC owner metadata"; return nil, true end
    for _, group in ipairs(scan.groups) do
        local existing
        for i, cached in ipairs(tuner.stateGroups) do
            local same = true
            for _, name in ipairs(dashKeys) do
                if tonumber(cached[name] and cached[name].addr) ~= group[name].addr then same = false; break end
            end
            if same then existing = i; break end
        end
        if existing then tuner.stateGroups[existing] = group
        else tuner.stateGroups[#tuner.stateGroups + 1] = group end
    end
    tuner.portableScan = nil
    local selected, matches = selectDashState(scan.groups, count, published)
    tuner.portableStatus = #scan.groups == 0 and "No verified dash table; check Matcha memory access/version" or nil
    log(string.format("Portable dash lookup: %d verified tables, %d live matches in %.3fs", #scan.groups, matches, tick() - scan.began))
    return selected, false
end
local function trackedNodeGroup(base, size, tracker, deadline)
    local scan = tracker.nodeScan
    if not scan or scan.base ~= base or scan.size ~= size then
        scan = { base = base, size = size, index = 0, group = { localNodes = true, tracked = true } }
        tracker.nodeScan = scan
    end
    local group, began = scan.group, tick()
    for index = scan.index, size - 1 do
        if deadline and index > scan.index and tick() >= deadline then
            scan.seconds = (scan.seconds or 0) + tick() - began
            scan.index = index; return nil, true
        end
        local address = base + index * 32
        local reference = memoryValue("uintptr_t", address + 16)
        if reference == tracker.historyRef then
            if scan.history or not nodeKey(address, "travelHistory", reference, tracker.historyTag)
                or memoryValue("uintptr_t", address) ~= tracker.history then tracker.nodeScan = nil; return end
            scan.history = address
        else
            for _, name in ipairs(dashKeys) do
                if reference == tracker.references[name] then
                    if group[name] or not nodeKey(address, name, reference) then tracker.nodeScan = nil; return end
                    group[name] = { key = name, type = "number", addr = address, tbl = tracker.address,
                        localNode = true, keyRef = reference, tableAddress = tracker.address,
                        nodeOffset = tracker.nodeOffset, nodeBase = base }
                end
            end
        end
    end
    tracker.nodeScan = nil
    if not scan.history then return end
    for _, name in ipairs(dashKeys) do if not group[name] then return end end
    group.lookupSeconds = (scan.seconds or 0) + tick() - began
    return group
end
local function prepareDashTracking(tuner, group)
    if tuner.tableTracker or not tuner.historySeeds or #tuner.historySeeds == 0 or type(memory_write) ~= "function" then return end
    local references, expected = {}, {}
    for _, name in ipairs(dashKeys) do
        local address = group and group[name] and tonumber(group[name].addr)
        if group and not validAddress(address) then return end
        references[name] = group and nodeKey(address, name) or (tuner.portableScan and tuner.portableScan.references[name])
        if not references[name] then return end
        if group then expected[name] = address end
