local function dashTrackingSearchStep(tuner, count, published)
    local search = tuner.trackerSearch
    if not search then return end
    local began = tick()
    for attempt = 1, 128 do
        if (search.seed > #search.seeds and not search.pending) or (attempt > 1 and tick() - began >= .002) then break end
        if search.pending then
            local candidate = search.pending[#search.pending]
            local tracker = candidate.tracker
            local group, pending = trackedNodeGroup(candidate.base, candidate.size, tracker, began + .002)
            if pending then return end
            table.remove(search.pending)
            if #search.pending == 0 then search.pending = nil end
            if group and search.expected then
                for _, name in ipairs(dashKeys) do
                    if group[name].addr ~= search.expected[name] then group = nil; break end
                end
            end
            if group and not search.matched[tracker.address] then
                search.matched[tracker.address] = true; search.matches[#search.matches + 1] = tracker
            end
        else
        local seed, cursor = search.seeds[search.seed], search.cursor
        local offset = math.ceil(cursor / 2) * 8 * (cursor % 2 == 0 and -1 or 1)
        local address = seed.history + offset
        search.cursor = cursor + 1
        if search.cursor > 1024 then search.cursor = 0; search.seed = search.seed + 1 end
        search.seen[seed.history] = search.seen[seed.history] or {}
        if not search.seen[seed.history][address] then
            search.seen[seed.history][address] = true
            for typeOffset = 0, 2 do
                if memoryValue("byte", address + typeOffset) == seed.historyTag then
                    for powerOffset = 3, 6 do
                        local power = memoryValue("byte", address + powerOffset)
                        if finite(power) and power >= 5 and power <= 8 and power % 1 == 0
                            and memoryValue("byte", address + powerOffset + 1) == (2 ^ power - 1) % 256 then
                            for nodeOffset = 16, 40, 8 do
                                local base = memoryValue("uintptr_t", address + nodeOffset)
                                if validAddress(base) and base >= 65536 then
                                    local tracker = { address = address, typeOffset = typeOffset, powerOffset = powerOffset,
                                        nodeOffset = nodeOffset, history = seed.history, historyRef = seed.historyRef,
