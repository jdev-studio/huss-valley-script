local function restoreCooldown(tuner)
    for key, saved in pairs(tuner.saved or {}) do
        if attr(tuner.object, key) == saved.applied then
            local success, err = pcall(function() tuner.object:SetAttribute(key, saved.natural) end)
            if not success then log(tuner.name .. " restore: " .. tostring(err)) end
        end
    end
    tuner.saved, tuner.object, tuner.natural, tuner.deadline, tuner.started, tuner.dashCount = {}, nil, nil, nil, nil, nil
    tuner.completed = false
    tuner.cache, tuner.candidates, tuner.observed, tuner.applied, tuner.corrected = nil, nil, nil, nil, nil
    tuner.pinned, tuner.writtenEntry, tuner.appliedAt = nil, nil, nil
    tuner.refreshPending = nil
    tuner.gates, tuner.nextGateScan, tuner.rearmedCount = nil, nil, nil
    tuner.stateGroups, tuner.stateGroup, tuner.stateLost, tuner.nextStateScan = nil, nil, nil, nil
    tuner.stateFaultAt, tuner.stateReadyAt = nil, nil
    tuner.stateRefreshActive = nil
    tuner.stateCandidates, tuner.stateObserved, tuner.stateProbeCount, tuner.stateValidatedCount = nil, nil, nil, nil
    tuner.nodeLayouts, tuner.nodeAnchor, tuner.nodeSearch, tuner.nodeAttempted = nil, nil, nil, nil
end
function app.stop()
    if not app.alive then return end
    app.alive = false
    if connection then connection:Disconnect() end
    for _, tuner in ipairs(cooldownTuners) do restoreCooldown(tuner) end
    if ui.Alive then ui:Destroy() end
    if rawget(_G, "ValleyJDUI") == app then rawset(_G, "ValleyJDUI", nil) end
    log("Stopped; movement writes ended; settings saved")
end

