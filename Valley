                        if not ownValue and current ~= tuner.natural then
                            tuner.natural = current; tuner.started = serverTime(); tuner.deadline = nil
                        end
                        if not finite(tuner.natural) or tuner.natural <= 0 then tuner.status = "Already ready"; return end
                        if tuner.seconds > 0 and tuner.natural < 1e9 then
                            tuner.status = "Unknown clock; use 0 for client reset"; return
                        end
                        tuner.deadline = tuner.deadline or (tuner.seconds == 0 and 0
                            or math.min(tuner.natural, tuner.started + tuner.seconds))
                        if tuner.deadline == tuner.natural then tuner.status = "Natural cooldown is shorter"; return end
                        local observed = cooldownWrite(tuner, tuner.key, tuner.deadline)
                        tuner.status = observed and "Readback applied; gameplay unverified" or "Write not observed; game may override"
                    end
                end)
