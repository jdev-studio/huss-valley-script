                    tuner.enabled = false; tuner.control:SetValue(false, true)
                    restoreCooldown(tuner); tuner.status = "Write rejected; tuning stopped"
                    log(tuner.name .. " cooldown: " .. tostring(err)); notify("Cooldown tuning stopped", tuner.name .. ": write rejected")
                end
            end
        end
    end
