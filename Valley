    if vector(direction) and horizontal(direction) > .01 then return direction end
    if not anyKeys then return nil end
    local cf = read(read(world, "CurrentCamera"), "CFrame")
    local look, right = read(cf, "LookVector"), read(cf, "RightVector")
    if not vector(look) or not vector(right) then
        local success, components = pcall(function() return { cf:GetComponents() } end)
        if not success or #components < 12 then return nil end
        look = Vector3.new(-components[6], -components[9], -components[12])
        right = Vector3.new(components[4], components[7], components[10])
    end

    local lookLength, rightLength = horizontal(look), horizontal(right)
    if lookLength < .001 or rightLength < .001 then return nil end
    return Vector3.new(look.X / lookLength * forward + right.X / rightLength * side, 0,
        look.Z / lookLength * forward + right.Z / rightLength * side)
end
local function movementStep(c, root, now)
    local reset = attr(c, "MovementReset")
    if finite(reset) and finite(lastMovementReset) and reset > lastMovementReset then
        log("Game movement reset " .. tostring(reset) .. "; requested speed " .. tostring(state.target))
    end
    lastMovementReset = reset
    if not state.speed then movementStatus = "Off"; return end
    if attr(c, "MovementLocked") ~= false then movementStatus = "Paused: movement lock/unknown"; return end
    if type(isrbxactive) == "function" then
        local active, focused = pcall(isrbxactive)
        if not active or not focused then movementStatus = "Paused: Roblox not focused"; return end
    end
    local humanoid = child(c, "Humanoid")
    local health = read(humanoid, "Health")
    if not finite(health) or health <= 0 then movementStatus = "Paused: no living character"; return end
    local v = read(root, "AssemblyLinearVelocity")
    if not vector(v) then
        if state.speed then disable("speed", "Velocity unavailable") end
        return
    end
    local magnitude = horizontal(v)
    if pendingVelocity and now - pendingVelocity.at >= .06 then
        movementStatus = math.abs(magnitude - pendingVelocity.target) < 3 and "Velocity observed" or "Game changed velocity"
        pendingVelocity = nil
    end
    local target, direction, directionLength
    if state.speed then
        local movementState = attr(c, "MovementState")
        if movementState == "Dashing" or movementState == "Dash" or movementState == "Boosting" then
            movementStatus = "Paused: natural dash motion"; return
        end
        direction = movementDirection(humanoid)
        if not direction or horizontal(direction) < .01 then
            pendingVelocity = nil; movementStatus = "Paused: no movement direction"; return
        end
        target = state.target; directionLength = horizontal(direction)
    end
    if not target then return end
    local success, err = pcall(function()
        root.AssemblyLinearVelocity = Vector3.new(direction.X / directionLength * target, v.Y,
            direction.Z / directionLength * target)
    end)
    if not success then
        if state.speed then disable("speed", "Velocity write rejected") end
        movementStatus = "Write rejected"; log(tostring(err)); return
    end
    if not pendingVelocity then pendingVelocity = { at = now, target = target } end
end
local function step()
    if not app.alive then return end
    if not ui.Alive then app.stop(); return end
    flushLog()
    local now = tick()
    local c = read(me, "Character")
    local root = child(c, "HumanoidRootPart")
    if id(c) ~= characterId then
        characterId = id(c); pendingVelocity = nil
        movementStatus = "Character changed"
        lastMovementReset = attr(c, "MovementReset")
    end
    if root then movementStep(c, root, now) else movementStatus = "Waiting for character" end
    cooldownStep(c, now)
    if now >= nextLabels then
        nextLabels = now + .2
        for _, label in ipairs(liveLabels) do label.control:SetDescription(label.provider()) end
    end
    if state.speed and now >= nextLog then
        nextLog = now + 3
        log("Movement " .. movementStatus)
    end
end
connection = run.RenderStepped:Connect(function()
    local success, err = pcall(step)
    if not success then log("Runtime error: " .. tostring(err)); app.stop() end
end)
