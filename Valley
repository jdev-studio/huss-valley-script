    if success then return value end
end
local function finite(n) return type(n) == "number" and n == n and math.abs(n) < 1e12 end
local function validAddress(n)
    return type(n) == "number" and n == n and n > 0 and n < 9007199254740992 and n % 1 == 0
end
local function vector(v)
    return v and finite(read(v, "X")) and finite(read(v, "Y")) and finite(read(v, "Z"))
end
local function id(object) return read(object, "Address") or object end
local function horizontal(v) return math.sqrt(v.X * v.X + v.Z * v.Z) end
local function key(vk)
