-- Both dash features share one view of the game's private movement table (MovementModel state).
-- In Matcha a GetAttribute costs ~0.8ms but a memory_read ~0.002ms, so the per-frame path reads memory only.
-- Luau node (32 bytes): value +0, value tag +12, key string +16, key tag (low 4 bits) and chain +28.
local requiredKeys = { "dashCount", "cooldown", "dashRemaining", "recoveryRemaining" }
local boostKeys = { "dashElapsed", "boostStart", "boostExit", "boostLift" }
local wantedKeys = { travelHistory = true }
for _, name in ipairs(requiredKeys) do wantedKeys[name] = true end
for _, name in ipairs(boostKeys) do wantedKeys[name] = true end
local keyNames = {} -- interned key string address -> name, learned on the first discovery
local function memoryValue(kind, address)
    local success, value = pcall(memory_read, kind, address)
    if success then return value end
end
local function number(address)
    if memoryValue("int", address + 12) ~= 3 then return end
    local value = memoryValue("double", address)
    if finite(value) then return value end
end
local function nodeName(address)
    local tag = memoryValue("int", address + 28)
    if not finite(tag) or tag % 16 ~= 6 then return end -- live string key only; free/dead nodes keep stale pointers
    local pointer = memoryValue("uintptr_t", address + 16)
    if not validAddress(pointer) or pointer < 65536 then return end
    local known = keyNames[pointer]
    if known then return known, pointer end
    local length = memoryValue("int", pointer + 20)
    if not finite(length) or length < 8 or length > 17 then return end
    local name = memoryValue("string", pointer + 24)
    if wantedKeys[name] and #name == length then return name, pointer end
end
local function scanNodes(base, size)
    local nodes = {}
    for index = 0, size - 1 do
        local address = base + index * 32
        local name, pointer = nodeName(address)
        if name then
            if nodes[name] then return end -- one key twice: not a live node array
            nodes[name], nodes[name .. "Key"] = address, pointer
        end
    end
    for _, name in ipairs(requiredKeys) do
        if not nodes[name] or not number(nodes[name]) then return end
    end
    for _, name in ipairs(boostKeys) do
        if not nodes[name] or not number(nodes[name]) then nodes.noBoost = true end
    end
    return nodes
end
-- The table header keeps its address for the character's whole life; only its node array moves on rehash.
local function headerNodes(header)
    local at = header.address
    if memoryValue("byte", at + header.typeOffset) ~= header.tag then return end
    local power = memoryValue("byte", at + header.powerOffset)
    if not finite(power) or power < 2 or power > 10
        or memoryValue("byte", at + header.powerOffset + 1) ~= (2 ^ power - 1) % 256 then return end
    local base = memoryValue("uintptr_t", at + header.nodeOffset)
    if validAddress(base) and base >= 65536 then return base, 2 ^ power end
end
local function discoverDash(c, count)
    local success, entries = pcall(getgc, { "travelHistory" })
    if not success or type(entries) ~= "table" then return nil, "Memory scan unavailable" end
    -- Layout measured live 2026-10-06; the full sweep only runs if Roblox reshuffles the table struct.
    local layouts = { dash.layout or { typeOffset = 1, powerOffset = 4, nodeOffset = 24 } }
    local reach = dash.layout and (dash.failures or 0) > 0 and 16384 or 1024 -- wide search only with one known layout
    if dash.layout == nil and dash.swept then
        for typeOffset = 0, 2 do for powerOffset = 3, 6 do for nodeOffset = 16, 40, 8 do
            layouts[#layouts + 1] = { typeOffset = typeOffset, powerOffset = powerOffset, nodeOffset = nodeOffset }
        end end end
    end
    local found, seen, owned = {}, {}, {}
    for _, entry in ipairs(entries) do
        local address = type(entry) == "table" and tonumber(entry.addr)
        local tag = validAddress(address) and memoryValue("int", address + 12)
        local history = tag and nodeName(address) == "travelHistory" and memoryValue("uintptr_t", address)
        if validAddress(history) and history >= 65536 and not seen[history] then
            seen[history] = true
            -- MovementModel.new() builds the table and its travelHistory together, so the header is allocated nearby.
            for offset = -reach, reach, 8 do
                local at = history + offset
                for _, layout in ipairs(layouts) do
                    local header = { address = at, tag = tag, typeOffset = layout.typeOffset,
                        powerOffset = layout.powerOffset, nodeOffset = layout.nodeOffset }
                    local base, size = headerNodes(header)
                    local nodes = base and not owned[base] and scanNodes(base, size)
                    local live = nodes and number(nodes.dashCount)
                    if live and live >= count and memoryValue("uintptr_t", nodes.travelHistory or 0) == history then
                        owned[base] = true
                        found[#found + 1] = { header = header, base = base, size = size, nodes = nodes, count = live }
                    end
                end
            end
        end
    end
    -- The scan blocks for 1-2s and the player may dash meanwhile, so compare against a fresh count.
    local fresh = attr(c, "DashCount")
    for i = #found, 1, -1 do
        if found[i].count ~= fresh then table.remove(found, i) end
    end
    if #found ~= 1 then
        if not dash.layout then dash.swept = true end -- next attempt tries every struct layout
        return nil, #found == 0 and "Dash state not found" or "Dash state ambiguous", fresh
    end
    local track = found[1]
    for _, name in ipairs(requiredKeys) do keyNames[track.nodes[name .. "Key"]] = name end
    for _, name in ipairs(boostKeys) do
        if track.nodes[name .. "Key"] then keyNames[track.nodes[name .. "Key"]] = name end
    end
    keyNames[track.nodes.travelHistoryKey] = "travelHistory"
    dash.layout = { typeOffset = track.header.typeOffset, powerOffset = track.header.powerOffset, nodeOffset = track.header.nodeOffset }
    return track, nil, fresh
