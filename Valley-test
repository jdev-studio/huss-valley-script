    if lunge.active or child(root, "LocalTackleVelocity") then
        pendingVelocity = nil; movementStatus = "Paused: tackle lunge"; return
    end
    if type(isrbxactive) == "function" then
        local active, focused = pcall(isrbxactive)
        if not active or not focused then movementStatus = "Paused: Roblox not focused"; return end
    end
