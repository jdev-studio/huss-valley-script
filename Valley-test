local function writeNumber(track, name, value)
    local address = track.nodes[name]
    if memoryValue("uintptr_t", address + 16) ~= track.nodes[name .. "Key"] or not number(address) then
        track.base = nil; return false -- node moved under us; the next frame re-reads the header
    end
    local written = pcall(memory_write, "double", address, value)
    local after = memoryValue("double", address)
    return written and finite(after) and math.abs(after - value) <= 1e-6
end
local function extendDash(track, count)
    local nodes = track.nodes
    if nodes.noBoost then dash.boost = "This dash type can't be extended"; return end
    local elapsed, remaining = number(nodes.dashElapsed), number(nodes.dashRemaining)
    local start, exit, lift = number(nodes.boostStart), number(nodes.boostExit), number(nodes.boostLift)
    if not (elapsed and remaining and start and exit and lift) then
        track.base = nil; dash.boost = "Dash state moved; next dash will extend"; return
    end
    if remaining <= 0 then
        dash.boost = "Dash ended before it could be extended"; return
    end
    -- RunBoost distance = duration * ((boostStart + boostExit) / 2 + boostLift); boostLift's share of the
    -- curve still ahead is 1 - (3u^2 - 2u^3), so this scales the whole dash exactly even a few frames late.
    local duration = elapsed + remaining
    local done = elapsed / duration
    if done > .5 then dash.boost = "Dash seen too late; next one will extend"; return end
    local pace = (start + exit) / 2 + lift
    if not writeNumber(track, "boostLift", lift + (dash.scale - 1) * pace / (1 - 3 * done * done + 2 * done * done * done)) then
        dash.boost = "Write not observed; retrying next dash"; return
    end
    dash.boost = string.format("Dash %s: %.1f -> %.1f studs", tostring(count), duration * pace, duration * pace * dash.scale)
end
local function loseDash(reason)
    dash.track, dash.status = nil, reason .. "; dash to find it again"
    log("Dash state: " .. reason)
end
local function dashStep(c, now)
    dash.motion = nil
    if activeRole ~= "Runner" or not dash.infinite and not dash.longer then dash.status = "Off"; return end
    if type(getgc) ~= "function" or type(memory_read) ~= "function" or type(memory_write) ~= "function" then
        dash.status = "Enable unsafe Lua execution in Matcha"; return
    end
    local character = id(c)
    if character ~= dash.character then
        dash.character, dash.track, dash.failedCount, dash.nextScan, dash.failures = character, nil, nil, now + .5, 0
    end
    if not c then dash.status = "Waiting for character"; return end
    local track = dash.track
    if not track then
        if now < (dash.nextScan or 0) then return end
        dash.nextScan = now + .5
        local count = attr(c, "DashCount")
        if not finite(count) or count <= 0 then dash.status = "Dash once to find the dash state"; return end
        if count == dash.failedCount then return end -- one scan per dash, never a scan loop
        local began = tick()
        local reason, fresh
        track, reason, fresh = discoverDash(c, count)
        if not track then
            -- Back off after repeated misses so a hard-to-find table never costs a freeze on every dash.
            dash.failures = dash.failures + 1
            dash.failedCount, dash.nextScan = finite(fresh) and fresh or count, tick() + math.min(30, 2 ^ dash.failures)
            dash.status = reason .. "; dash again to retry"
            log(string.format("Dash state: %s (%.2fs)", reason, tick() - began)); return
        end
        now = tick()
        track.checkAt, track.misses, dash.failures = now + 2, 0, 0
        dash.track, dash.lastCount = track, fresh
        log(string.format("Dash state found @%s in %.2fs%s", tostring(track.header.address), tick() - began,
            track.nodes.noBoost and "; no RunBoost fields" or ""))
    end
    local base, size = headerNodes(track.header)
    local moved = base and (base ~= track.base or size ~= track.size) and scanNodes(base, size)
    if not base or moved == nil then
        -- Mid-rehash (header bytes and node array change together) or a freed table: wait before giving up.
        track.misses = track.misses + 1
        if track.misses > 30 then loseDash("Dash state moved and was not found") end
        return
    end
    if moved then track.base, track.size, track.nodes = base, size, moved end
    local nodes = track.nodes
    local count, remaining = number(nodes.dashCount), number(nodes.dashRemaining)
    if not count or not remaining then track.base = nil; return end
    track.misses = 0
    dash.motion = remaining > 0
    if now >= track.checkAt then
        track.checkAt = now + 2
        local published = attr(c, "DashCount")
        track.mismatch = finite(published) and published ~= count and (track.mismatch or 0) + 1 or 0
        if track.mismatch >= 2 then loseDash("Dash state stopped matching the game"); return end
    end
    if count ~= dash.lastCount then
        dash.lastCount = count
        if dash.longer then extendDash(track, count) end
    end
    if dash.infinite then
        local cooldown, recovery = number(nodes.cooldown), number(nodes.recoveryRemaining)
        if not cooldown or not recovery then track.base = nil; return end -- node moved: re-walk next frame
        if cooldown and cooldown > 0 then writeNumber(track, "cooldown", 0) end
        -- Recovery starts when the motion ends; clearing it then keeps the full (longer) dash.
        if remaining <= 0 and recovery and recovery > 0 then writeNumber(track, "recoveryRemaining", 0) end
    end
    dash.status = remaining > 0 and "Dashing" or "Ready: turn + Space to dash"
end
local function movementDirection(humanoid)
    local forward = (key(0x57) and 1 or 0) - (key(0x53) and 1 or 0)
    local side = (key(0x44) and 1 or 0) - (key(0x41) and 1 or 0)
    local anyKeys = key(0x57) or key(0x53) or key(0x44) or key(0x41)
    if anyKeys and forward == 0 and side == 0 then return nil end
    local direction = read(humanoid, "MoveDirection")
    if vector(direction) and horizontal(direction) > .01 then return direction end
    if not anyKeys then return nil end
    local cf = read(read(world, "CurrentCamera"), "CFrame")
    local look, right = read(cf, "LookVector"), read(cf, "RightVector")
    if not vector(look) or not vector(right) then
        local success, components = pcall(function() return { cf:GetComponents() } end)
        if not success or #components < 12 then return nil end
        look = Vector3.new(-components[6], -components[9], -components[12])
        right = Vector3.new(components[4], components[7], components[10])
    end

    local lookLength, rightLength = horizontal(look), horizontal(right)
    if lookLength < .001 or rightLength < .001 then return nil end
    return Vector3.new(look.X / lookLength * forward + right.X / rightLength * side, 0,
        look.Z / lookLength * forward + right.Z / rightLength * side)
end
